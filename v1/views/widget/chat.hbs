{{!-- * BODY --}}
<body class="vertical-layout page-header-light vertical-menu-collapsible vertical-menu-nav-dark preload-transitions 2-columns" data-open="click" data-menu="vertical-menu-nav-dark" data-col="2-columns">

    {{!-- todo: control notificaciones --}}
    <div id="controlNotificaciones" class="controlNotificaciones">
        {{!-- Contenido de notificaciones --}}
    </div>

    {{!-- todo: main --}}
    <div id="main">
        {{!-- todo: conversación --}}
        <div id="conversacion">
            {{!-- <div class="mensaje-recibido">
                <div class="texto">¡Absolutamente, estamos ante algo supremamente importante y que merece ser tratado con la debida seriedad!</div>
            </div>

            <div class="mensaje-enviado">
                <div class="texto">¡Claro que sí!</div>
            </div>

            <div class="mensaje-recibido">
                <div class="texto">ok!</div>
            </div>

            <div class="mensaje-enviado">
                <div class="texto"><p class="saludoChat"><strong>Bienvenida@ al sistema.</strong></p></div>
            </div> --}}
        </div>
        
        {{!-- todo: Contenido del formulario --}}
        <div id="contentFormTexto">
            <div class="row">
                {{!-- todo: Mensaje --}}
                <div id="div_mensaje" class="input-field col s12" style="position: relative;">
                    <textarea id="txt_mensaje" name="txt_mensaje" class="materialize-textarea campo-formulario" rows="1" maxlength="1000" data-length="1000" autocomplete="off"></textarea>
                    <label for="txt_mensaje">Mensaje</label>
                    {{!-- Icono de adjunto que aparece cuando hay mensaje tipo Paso Agente (texto -> adjuntos) --}}
                    <i id="iconoAdjuntarPasoAgente" class="material-icons icono-paso-agente icono-paso-agente-adjuntar">attach_file</i>
                </div>
            </div>

            {{!-- todo: Botones --}}
            <div class="center">
                <button id="btnEnviar" class="btn waves-effect waves-light blue darken-1 mb-0">
                    <i class="material-icons left">send</i>Enviar
                </button>
            </div>
        </div>

        {{!-- todo: Contenido de adjuntos --}}
        <div id="contentAdjuntos" class="hide">
            <div id="file-upload" class="section">
                <div class="row section">
                    <div class="col s12 m4 l3">
                    </div>
                    <div class="col s12 m8 l9">
                        <input type="file" class="dropify" id="input-file-now" multiple accept=".pdf,.xls,.xlsx,.jpg,.png,.doc,.docx" data-max-file-size="5M" />
                    </div>
                </div>
                <div id="file-list"></div>
            </div>

            {{!-- todo: Botones --}}
            <div class="center">
                <button id="btnAdjuntar" class="btn waves-effect waves-light blue darken-1 mb-0">
                    <i class="material-icons left">attach_file</i>Adjuntar
                </button>
                {{!-- Icono para volver a texto cuando estamos en adjuntos (Paso Agente) --}}
                <i id="iconoTextoPasoAgente" class="material-icons icono-paso-agente icono-paso-agente-texto">chat</i>
            </div>
        </div>
    </div>

